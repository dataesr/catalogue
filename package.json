{
  "name": "@dataesr/catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build app/main.tsx --outdir=dist/client --target=browser --minify --sourcemap",
    "compile": "bun build --compile --target=bun-linux-x64 server.ts --outfile=dist/server",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@dataesr/declic-sdk": "staging",
    "@dataesr/declic-types": "staging",
    "@elastic/elasticsearch": "^8.0.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/eden": "^1.4.6",
    "@elysiajs/openapi": "^1.4.13",
    "@gouvfr/dsfr": "^1.14.3",
    "@tanstack/react-query": "^5.90.16",
    "classnames": "^2.5.1",
    "elysia": "^1.4.19",
    "he": "^1.2.0",
    "nuqs": "^2.8.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.11.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/he": "^1.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
